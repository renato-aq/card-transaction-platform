{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Fraud": {
    "Rules": {
      "Velocity": {
        "Threshold": 5,
        "Window": "00:01:00"
      },
      "AmountAboveAverage": {
        "Multiplier": 3,
        "MinimumHistory": 5
      }
    }
  }
}
